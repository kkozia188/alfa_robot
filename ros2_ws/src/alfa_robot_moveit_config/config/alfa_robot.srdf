<?xml version="1.0" encoding="UTF-8"?>
<robot name="alfa_robot">
    <group name="base_group">
        <joint name="updown"/>
    </group>
    <group name="torso_group">
        <joint name="pitch"/>
        <joint name="turn"/>
        <joint name="updown"/>
    </group>
    <group name="left_arm">
        <chain base_link="left_arm_base" tip_link="left_tool0"/>
    </group>
    <group name="right_arm">
        <chain base_link="right_arm_base" tip_link="right_tool0"/>
    </group>
    <group name="dual_arm">
        <group name="left_arm"/>
        <group name="right_arm"/>
    </group>
    <group name="left_arm_with_base">
        <joint name="updown"/>
        <group name="left_arm"/>
    </group>
    <group name="right_arm_with_base">
        <joint name="updown"/>
        <group name="right_arm"/>
    </group>
    <group name="dual_arm_with_base">
        <joint name="updown"/>
        <group name="left_arm"/>
        <group name="right_arm"/>
    </group>
    <group name="left_tool_group">
        <link name="left_tool0"/>
    </group>
    <group name="right_tool_group">
        <link name="right_tool0"/>
    </group>
    <group_state name="home" group="dual_arm_with_base">
        <joint name="updown" value="0.0"/>
        <joint name="leftjoint1" value="0"/>
        <joint name="leftjoint2" value="0.0"/>
        <joint name="leftjoint3" value="0.0"/>
        <joint name="leftjoint4" value="0"/>
        <joint name="leftjoint5" value="0.0"/>
        <joint name="leftjoint6" value="0"/>
        <joint name="rightjoint1" value="0"/>
        <joint name="rightjoint2" value="0.0"/>
        <joint name="rightjoint3" value="0.0"/>
        <joint name="rightjoint4" value="0"/>
        <joint name="rightjoint5" value="0.0"/>
        <joint name="rightjoint6" value="0"/>
    </group_state>
    <end_effector name="left_tool" parent_link="left_tool0" group="left_tool_group" parent_group="left_arm"/>
    <end_effector name="right_tool" parent_link="right_tool0" group="right_tool_group" parent_group="right_arm"/>
    <end_effector name="left_tool_with_base" parent_link="left_tool0" group="left_tool_group" parent_group="left_arm_with_base"/>
    <end_effector name="right_tool_with_base" parent_link="right_tool0" group="right_tool_group" parent_group="right_arm_with_base"/>
    <end_effector name="left_tool_dual_base" parent_link="left_tool0" group="left_tool_group" parent_group="dual_arm_with_base"/>
    <end_effector name="right_tool_dual_base" parent_link="right_tool0" group="right_tool_group" parent_group="dual_arm_with_base"/>
    <virtual_joint name="world_to_base" type="fixed" parent_frame="world" child_link="base_link"/>
    <disable_collisions link1="base_link" link2="pitch" reason="Adjacent"/>
    <disable_collisions link1="base_link" link2="turn" reason="Never"/>
    <disable_collisions link1="pitch" link2="turn" reason="Adjacent"/>
    <disable_collisions link1="turn" link2="updown" reason="Adjacent"/>
    <disable_collisions link1="updown" link2="front_sensor" reason="Adjacent"/>
    <disable_collisions link1="turn" link2="lidar_front" reason="Adjacent"/>
    <disable_collisions link1="turn" link2="lidar_rear" reason="Adjacent"/>
    <disable_collisions link1="turn" link2="cam_front" reason="Adjacent"/>
    <disable_collisions link1="turn" link2="cam_rear" reason="Adjacent"/>
    <disable_collisions link1="left_arm_base" link2="leftjoint1" reason="Adjacent"/>
    <disable_collisions link1="updown" link2="leftjoint1" reason="Adjacent"/>
    <disable_collisions link1="updown" link2="rightjoint1" reason="Adjacent"/>
    <disable_collisions link1="leftjoint1" link2="leftjoint2" reason="Adjacent"/>
    <disable_collisions link1="leftjoint2" link2="leftjoint3" reason="Adjacent"/>
    <disable_collisions link1="leftjoint3" link2="leftjoint4" reason="Adjacent"/>
    <disable_collisions link1="leftjoint4" link2="leftjoint5" reason="Adjacent"/>
    <disable_collisions link1="leftjoint5" link2="leftjoint6" reason="Adjacent"/>
    <disable_collisions link1="right_arm_base" link2="rightjoint1" reason="Adjacent"/>
    <disable_collisions link1="rightjoint1" link2="rightjoint2" reason="Adjacent"/>
    <disable_collisions link1="rightjoint2" link2="rightjoint3" reason="Adjacent"/>
    <disable_collisions link1="rightjoint3" link2="rightjoint4" reason="Adjacent"/>
    <disable_collisions link1="rightjoint4" link2="rightjoint5" reason="Adjacent"/>
    <disable_collisions link1="rightjoint5" link2="rightjoint6" reason="Adjacent"/>
    <!-- Arm vs Base collisions are intentionally enabled globally. -->
    <!-- Suction/link6 vs own arm collisions are intentionally enabled. -->
    <disable_collisions link1="left_tool0" link2="left_arm_base" reason="Never"/>
    <disable_collisions link1="left_tool0" link2="leftjoint1" reason="Never"/>
    <disable_collisions link1="left_tool0" link2="leftjoint2" reason="Never"/>
    <disable_collisions link1="left_tool0" link2="leftjoint3" reason="Never"/>
    <disable_collisions link1="left_tool0" link2="leftjoint4" reason="Never"/>
    <disable_collisions link1="left_tool0" link2="leftjoint5" reason="Never"/>
    <disable_collisions link1="left_tool0" link2="leftjoint6" reason="Never"/>
    <disable_collisions link1="right_tool0" link2="right_arm_base" reason="Never"/>
    <disable_collisions link1="right_tool0" link2="rightjoint1" reason="Never"/>
    <disable_collisions link1="right_tool0" link2="rightjoint2" reason="Never"/>
    <disable_collisions link1="right_tool0" link2="rightjoint3" reason="Never"/>
    <disable_collisions link1="right_tool0" link2="rightjoint4" reason="Never"/>
    <disable_collisions link1="right_tool0" link2="rightjoint5" reason="Never"/>
    <disable_collisions link1="right_tool0" link2="rightjoint6" reason="Never"/>
</robot>
