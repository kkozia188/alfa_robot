    <!-- rightjoint4 -->
    <joint name="${prefix}leftjoint4" type="prismatic">
      <origin xyz="0.376 0.026 0.0023" rpy="1.5708 0 0"/>
      <parent link="${prefix}leftjoint3_link"/>
      <child link="${prefix}leftjoint4_link"/>
      <axis xyz="1 0 0"/>
      <limit lower="0" upper="0.15" effort="0" velocity="0"/>
    </joint>

    <!-- leftjoint5 (new joint for 6DOF) -->
    <joint name="${prefix}leftjoint5" type="continuous">
      <origin xyz="0.092 0.0018 0" rpy="-1.5708 0 0"/>
      <parent link="${prefix}leftjoint4_link"/>
      <child link="${prefix}leftjoint5_link"/>
      <axis xyz="0 0 1"/>
      <limit lower="-3.14" upper="3.14" effort="0" velocity="0"/>
    </joint>

    <!-- right_ee_joint (virtual fixed joint for MoveIt2 end effector) -->
    <joint name="${prefix}left_ee_joint" type="fixed">
      <origin xyz="0.05 0 0" rpy="0 0 0"/>
      <parent link="${prefix}leftjoint5_link"/>
      <child link="${prefix}left_ee_link"/>
    </joint>

    <!-- camera -->
    <joint name="${prefix}camera" type="fixed">
      <origin xyz="0.51384 0 0.07785" rpy="0 0 0"/>
      <parent link="${prefix}updown_link"/>
      <child link="${prefix}camera_link"/>
    </joint>

    <!-- lidar -->
    <joint name="${prefix}lidar" type="fixed">
      <origin xyz="0.46082 0 0.13841" rpy="0 0 0"/>
      <parent link="${prefix}updown_link"/>
      <child link="${prefix}lidar_link"/>
    </joint>

    <!-- END JOINTS -->

  </xacro:macro>
</robot>
