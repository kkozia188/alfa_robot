    <!-- right_ee_link (virtual end effector for MoveIt2 planning) -->
    <link name="${prefix}right_ee_link"/>

    <!-- left_ee_link (virtual end effector for MoveIt2 planning) -->
    <link name="${prefix}left_ee_link"/>

    <!-- END LINKS -->

    <!-- JOINTS -->
    <!-- base_joint fixes base_link to the environment -->
    <joint name="${prefix}base_joint" type="fixed">
      <xacro:insert_block name="origin"/>
      <parent link="${parent}"/>
      <child link="${prefix}base_link"/>
    </joint>

    <!-- turn -->
    <joint name="${prefix}turn" type="continuous">
      <origin xyz="-0.007937 0 0.129" rpy="0 0 0"/>
      <parent link="${prefix}base_link"/>
      <child link="${prefix}turn_link"/>
      <axis xyz="0 0 1"/>
    </joint>

    <!-- updown -->
    <joint name="${prefix}updown" type="prismatic">
      <origin xyz="-0.23547 0 0.45934" rpy="0 0 0"/>
      <parent link="${prefix}turn_link"/>
      <child link="${prefix}updown_link"/>
      <axis xyz="0 0 1"/>
      <limit lower="0" upper="0.95" effort="1000" velocity="1"/>
    </joint>

    <!-- plate (new joint) -->
    <joint name="${prefix}plate" type="prismatic">
      <origin xyz="0.42217 0 0.0325" rpy="0 0 0"/>
      <parent link="${prefix}updown_link"/>
      <child link="${prefix}plate_link"/>
      <axis xyz="1 0 0"/>
