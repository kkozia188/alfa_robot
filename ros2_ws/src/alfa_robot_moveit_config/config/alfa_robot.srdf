<?xml version="1.0" encoding="UTF-8"?>
<robot name="alfa_robot">
    <group name="left_arm">
        <chain base_link="arm_carriage" tip_link="left_joint7"/>
    </group>
    <group name="right_arm">
        <chain base_link="arm_carriage" tip_link="right_joint7"/>
    </group>
    <group name="dual_arm">
        <group name="left_arm"/>
        <group name="right_arm"/>
    </group>
    <group name="dual_arm_with_updown">
        <joint name="updown"/>
        <group name="dual_arm"/>
    </group>
    <group name="whole">
        <joint name="rear_suspension_joint"/>
        <joint name="front_left_steering_joint"/>
        <joint name="front_left_wheel_joint"/>
        <joint name="front_right_steering_joint"/>
        <joint name="front_right_wheel_joint"/>
