<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="alfa_robot">

  <xacro:arg name="prefix" default=""/>
  <xacro:arg name="use_mock_hardware" default="true"/>
  <xacro:arg name="mock_sensor_commands" default="true"/>
  <xacro:arg name="arm_mount_forward_offset" default="0"/>
  <xacro:arg name="base_link_x" default="0.195"/>
  <xacro:arg name="base_link_y" default="0.015"/>
  <xacro:arg name="base_link_z" default="0.400"/>
  <xacro:arg name="updown_initial" default="-0.5"/>
  <xacro:arg name="head_joint_initial" default="0.0"/>
  <xacro:arg name="left_joint1_initial" default="2.61799387799"/>
  <xacro:arg name="left_joint2_initial" default="1.57079632679"/>
  <xacro:arg name="left_joint3_initial" default="-0.0872664625997"/>
  <xacro:arg name="left_joint4_initial" default="2.09439510239"/>
  <xacro:arg name="left_joint5_initial" default="0.0"/>
  <xacro:arg name="left_joint6_initial" default="0.0"/>
  <xacro:arg name="left_joint7_initial" default="0.0"/>
  <xacro:arg name="right_joint1_initial" default="-2.61799387799"/>
  <xacro:arg name="right_joint2_initial" default="-1.57079632679"/>
  <xacro:arg name="right_joint3_initial" default="0.0872664625997"/>
  <xacro:arg name="right_joint4_initial" default="-2.09439510239"/>
  <xacro:arg name="right_joint5_initial" default="0.0"/>
  <xacro:arg name="right_joint6_initial" default="0.0"/>
  <xacro:arg name="right_joint7_initial" default="0.0"/>

  <xacro:include filename="$(find alfa_robot_description)/urdf/alfa_robot/alfa_robot_macro.ros2_control.xacro"/>
  <xacro:property name="arm_mount_forward_offset_value" value="$(arg arm_mount_forward_offset)"/>
  <xacro:include filename="$(find alfa_robot_description)/urdf/alfa_robot/robot_v3_1_1.xacro"/>

  <link name="base_footprint"/>
  <joint name="base_footprint_to_base_link" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="$(arg base_link_x) $(arg base_link_y) $(arg base_link_z)" rpy="0 0 0"/>
  </joint>

  <link name="base_link"/>
  <joint name="base_to_model" type="fixed">
    <parent link="base_link"/>
    <child link="model_base"/>
    <origin
      xyz="${-0.174000020720362 + float(arm_mount_forward_offset_value)} 6.50500007062811e-09 0.802299964909"
      rpy="1.5707963 0 1.57079632679"/>
  </joint>

  <xacro:alfa_robot_ros2_control
    name="alfa_robot"
    prefix="$(arg prefix)"
    use_mock_hardware="$(arg use_mock_hardware)"
    mock_sensor_commands="$(arg mock_sensor_commands)"
    updown_initial="$(arg updown_initial)"
    head_joint_initial="$(arg head_joint_initial)"
    left_joint1_initial="$(arg left_joint1_initial)"
    left_joint2_initial="$(arg left_joint2_initial)"
    left_joint3_initial="$(arg left_joint3_initial)"
    left_joint4_initial="$(arg left_joint4_initial)"
    left_joint5_initial="$(arg left_joint5_initial)"
    left_joint6_initial="$(arg left_joint6_initial)"
    left_joint7_initial="$(arg left_joint7_initial)"
    right_joint1_initial="$(arg right_joint1_initial)"
    right_joint2_initial="$(arg right_joint2_initial)"
    right_joint3_initial="$(arg right_joint3_initial)"
    right_joint4_initial="$(arg right_joint4_initial)"
    right_joint5_initial="$(arg right_joint5_initial)"
    right_joint6_initial="$(arg right_joint6_initial)"
    right_joint7_initial="$(arg right_joint7_initial)"/>

</robot>
