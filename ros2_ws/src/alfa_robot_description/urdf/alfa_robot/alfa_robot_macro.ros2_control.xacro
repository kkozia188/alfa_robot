<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">

  <xacro:macro name="alfa_robot_ros2_control" params="
               name
               prefix
               use_mock_hardware:=false
               mock_sensor_commands:=false
               real_hardware_plugin:=mock_components/GenericSystem
               canopen_profile_velocity:=50000
               canopen_profile_accel:=50000
               pitch_initial:=0.0
               turn_initial:=0.0
               updown_initial:=0.0
               left_joint1_initial:=0.0
               left_joint2_initial:=0.0
               left_joint3_initial:=0.0
               left_joint4_initial:=0.0
               left_joint5_initial:=0.0
               left_joint6_initial:=0.0
               right_joint1_initial:=0.0
               right_joint2_initial:=0.0
               right_joint3_initial:=0.0
               right_joint4_initial:=0.0
               right_joint5_initial:=0.0
               right_joint6_initial:=0.0"
               >

    <ros2_control name="${name}" type="system">
      <hardware>
        <xacro:if value="${use_mock_hardware}">
          <plugin>mock_components/GenericSystem</plugin>
          <param name="mock_sensor_commands">${mock_sensor_commands}</param>
        </xacro:if>
        <xacro:unless value="${use_mock_hardware}">
          <plugin>${real_hardware_plugin}</plugin>
          <param name="can_interface_left">can0</param>
          <param name="can_interface_right">can1</param>
          <param name="can_interface_canopen">can3</param>
          <param name="can_interface_base">can2</param>
          <param name="can_interface_plate">can4</param>
          <param name="canopen_profile_velocity">${canopen_profile_velocity}</param>
          <param name="canopen_profile_accel">${canopen_profile_accel}</param>

          <!-- Safe shutdown configuration -->
          <param name="use_safe_shutdown">true</param>

          <!-- Safe positions (rad for revolute, m for prismatic) -->
          <param name="safe_position_turn">0.0</param>
          <param name="safe_position_updown">0.0</param>
        </xacro:unless>
      </hardware>
      <!-- pitch (revolute) -->
      <joint name="${prefix}pitch">
        <command_interface name="position">
          <param name="min">0</param>
          <param name="max">0.26</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">${pitch_initial}</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="acceleration"/>
      </joint>

      <!-- turn (continuous; no URDF limit tag) -->
      <joint name="${prefix}turn">
        <command_interface name="position"/>
        <state_interface name="position">
          <param name="initial_value">${turn_initial}</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="acceleration"/>
      </joint>

      <!-- updown (prismatic) -->
      <joint name="${prefix}updown">
        <command_interface name="position">
          <param name="min">0.0</param>
          <param name="max">0.7</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">${updown_initial}</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="acceleration"/>
      </joint>

      <!-- dual arms (position controlled) -->
      <xacro:macro name="arm_control_joint" params="joint_name lower upper velocity initial_value:=0.0">
        <joint name="${prefix}${joint_name}">
          <command_interface name="position">
            <param name="min">${lower}</param>
            <param name="max">${upper}</param>
          </command_interface>
          <state_interface name="position">
            <param name="initial_value">${initial_value}</param>
          </state_interface>
          <state_interface name="velocity"/>
          <state_interface name="acceleration"/>
        </joint>
      </xacro:macro>

      <xacro:arm_control_joint joint_name="left_joint1" lower="-1.57079632679" upper="1.57079632679" velocity="1.2" initial_value="${left_joint1_initial}"/>
      <xacro:arm_control_joint joint_name="left_joint2" lower="-1.57079632679" upper="1.57079632679" velocity="1.2" initial_value="${left_joint2_initial}"/>
      <xacro:arm_control_joint joint_name="left_joint3" lower="-2.44346095279" upper="2.44346095279" velocity="1.2" initial_value="${left_joint3_initial}"/>
      <xacro:arm_control_joint joint_name="left_joint4" lower="-3.14159265359" upper="3.14159265359" velocity="1.5" initial_value="${left_joint4_initial}"/>
      <xacro:arm_control_joint joint_name="left_joint5" lower="-2.18166156499" upper="2.18166156499" velocity="1.5" initial_value="${left_joint5_initial}"/>
      <xacro:arm_control_joint joint_name="left_joint6" lower="-3.12413936107" upper="3.12413936107" velocity="1.5" initial_value="${left_joint6_initial}"/>
      <xacro:arm_control_joint joint_name="right_joint1" lower="-1.57079632679" upper="1.57079632679" velocity="1.2" initial_value="${right_joint1_initial}"/>
      <xacro:arm_control_joint joint_name="right_joint2" lower="-1.57079632679" upper="1.57079632679" velocity="1.2" initial_value="${right_joint2_initial}"/>
      <xacro:arm_control_joint joint_name="right_joint3" lower="-2.44346095279" upper="2.44346095279" velocity="1.2" initial_value="${right_joint3_initial}"/>
      <xacro:arm_control_joint joint_name="right_joint4" lower="-3.14159265359" upper="3.14159265359" velocity="1.5" initial_value="${right_joint4_initial}"/>
      <xacro:arm_control_joint joint_name="right_joint5" lower="-2.18166156499" upper="2.18166156499" velocity="1.5" initial_value="${right_joint5_initial}"/>
      <xacro:arm_control_joint joint_name="right_joint6" lower="-3.12413936107" upper="3.12413936107" velocity="1.5" initial_value="${right_joint6_initial}"/>


    </ros2_control>
  </xacro:macro>
</robot>
