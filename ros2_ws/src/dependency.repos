# Source dependencies for alfa_robot_ws on ROS 2 Humble / Ubuntu 22.04.
#
# Usage:
#   cd ~/alfa_robot_ws
#   vcs import src < src/dependency.repos
#   # MoveIt keeps part of its transitive source dependencies in its own repos file.
#   vcs import src < src/moveit2/moveit2.repos
#   rosdep update
#   rosdep install --from-paths src --ignore-src -r -y
#
# Notes:
# - Core ROS packages such as rclcpp, tf2_ros, robot_state_publisher, xacro,
#   rviz2 and joint_state_publisher_gui are expected to come from
#   /opt/ros/humble via apt/rosdep.
# - alfa_robot_moveit_config declares warehouse_ros_mongo, but that package is
#   not consistently available on Humble as a binary. Most users can ignore it
#   unless they need MoveIt warehouse database features.
repositories:
  moveit2:
    type: git
    url: https://github.com/moveit/moveit2.git
    version: humble

  moveit_msgs:
    type: git
    url: https://github.com/moveit/moveit_msgs.git
    version: humble

  ros2_control:
    type: git
    url: https://github.com/ros-controls/ros2_control.git
    version: humble

  ros2_controllers:
    type: git
    url: https://github.com/ros-controls/ros2_controllers.git
    version: humble
