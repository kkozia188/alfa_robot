<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">

  <xacro:macro name="alfa_robot_ros2_control" params="
               name
               prefix
               use_mock_hardware:=false
               mock_sensor_commands:=false
               sim_gazebo_classic:=false
               sim_gazebo:=false
               simulation_controllers
               real_hardware_plugin:=alfa_robot_hardware/AlfaRobotHW
               canopen_profile_velocity:=50000
               canopen_profile_accel:=50000"
               >

    <ros2_control name="${name}" type="system">
      <hardware>
        <xacro:if value="${use_mock_hardware}">
          <plugin>mock_components/GenericSystem</plugin>
          <param name="mock_sensor_commands">${mock_sensor_commands}</param>
        </xacro:if>
        <xacro:if value="${sim_gazebo_classic}">
          <plugin>gazebo_ros2_control/GazeboSystem</plugin>
        </xacro:if>
        <xacro:if value="${sim_gazebo}">
          <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </xacro:if>
        <xacro:unless value="${use_mock_hardware or sim_gazebo_classic or sim_gazebo}">
          <plugin>${real_hardware_plugin}</plugin>
          <param name="can_interface_left">can0</param>
          <param name="can_interface_right">can1</param>
          <param name="can_interface_canopen">can3</param>
          <param name="can_interface_base">can2</param>
          <param name="can_interface_plate">can4</param>
          <param name="canopen_profile_velocity">${canopen_profile_velocity}</param>
          <param name="canopen_profile_accel">${canopen_profile_accel}</param>

          <!-- Safe shutdown configuration -->
          <param name="use_safe_shutdown">true</param>

          <!-- Safe positions (rad for revolute, m for prismatic) -->
          <param name="safe_position_turn">0.0</param>
          <param name="safe_position_updown">0.0</param>
          <param name="safe_position_leftarmbase">0.0</param>
          <param name="safe_position_leftjoint1">0.0</param>
          <param name="safe_position_leftjoint2">0.0</param>
          <param name="safe_position_leftjoint3">0.0</param>
          <param name="safe_position_leftjoint4">0.0</param>
          <param name="safe_position_leftjoint5">0.0</param>
          <param name="safe_position_rightarmbase">0.0</param>
          <param name="safe_position_rightjoint1">0.0</param>
          <param name="safe_position_rightjoint2">0.0</param>
          <param name="safe_position_rightjoint3">0.0</param>
          <param name="safe_position_rightjoint4">0.0</param>
          <param name="safe_position_plate">0.0</param>
        </xacro:unless>
      </hardware>
      <!-- turn (continuous) -->
      <joint name="${prefix}turn">
        <command_interface name="position">
          <param name="min">-3.14159</param>
          <param name="max">3.14159</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="acceleration"/>
      </joint>

      <!-- updown (prismatic) -->
      <joint name="${prefix}updown">
        <command_interface name="position">
          <param name="min">0</param>
          <param name="max">1.0</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="acceleration"/>
      </joint>

      <!-- plate (prismatic, new) -->
      <joint name="${prefix}plate">
        <command_interface name="position">
          <param name="min">0</param>
          <param name="max">0.5</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="acceleration"/>
      </joint>

      <!-- rightarmbase (prismatic) -->
      <joint name="${prefix}rightarmbase">
        <command_interface name="position">
          <param name="min">0</param>
          <param name="max">0.16</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="acceleration"/>
      </joint>

      <!-- rightjoint1 (prismatic) -->
      <joint name="${prefix}rightjoint1">
        <command_interface name="position">
          <param name="min">0</param>
          <param name="max">0.5</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="acceleration"/>
      </joint>

      <!-- rightjoint2 (continuous) -->
      <joint name="${prefix}rightjoint2">
        <command_interface name="position">
          <param name="min">-3.14159</param>
          <param name="max">3.14159</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="acceleration"/>
      </joint>

      <!-- rightjoint3 (continuous) -->
      <joint name="${prefix}rightjoint3">
        <command_interface name="position">
          <param name="min">-3.14159</param>
          <param name="max">3.14159</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="acceleration"/>
      </joint>

      <!-- rightjoint4 (continuous) -->
      <joint name="${prefix}rightjoint4">
        <command_interface name="position">
          <param name="min">-3.14159</param>
          <param name="max">3.14159</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="acceleration"/>
      </joint>

      <!-- leftarmbase (prismatic) -->
      <joint name="${prefix}leftarmbase">
        <command_interface name="position">
          <param name="min">-0.16</param>
          <param name="max">0</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="acceleration"/>
      </joint>

      <!-- leftjoint1 (prismatic) -->
      <joint name="${prefix}leftjoint1">
        <command_interface name="position">
          <param name="min">0</param>
          <param name="max">0.45</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="acceleration"/>
      </joint>

      <!-- leftjoint2 (continuous) -->
      <joint name="${prefix}leftjoint2">
        <command_interface name="position">
          <param name="min">-3.14159</param>
          <param name="max">3.14159</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="acceleration"/>
      </joint>

      <!-- leftjoint3 (continuous) -->
      <joint name="${prefix}leftjoint3">
        <command_interface name="position">
          <param name="min">-3.14159</param>
          <param name="max">3.14159</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="acceleration"/>
      </joint>

      <!-- leftjoint4 (prismatic) -->
      <joint name="${prefix}leftjoint4">
        <command_interface name="position">
          <param name="min">0</param>
          <param name="max">0.22</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="acceleration"/>
      </joint>

      <!-- leftjoint5 (continuous) -->
      <joint name="${prefix}leftjoint5">
        <command_interface name="position">
          <param name="min">-3.14159</param>
          <param name="max">3.14159</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="acceleration"/>
      </joint>

    </ros2_control>

    <xacro:if value="$(arg sim_gazebo_classic)">
      <!-- Gazebo plugins -->
      <gazebo reference="world">
      </gazebo>
      <gazebo>
        <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
          <parameters>${simulation_controllers}</parameters>
        </plugin>
      </gazebo>
    </xacro:if>

    <xacro:if value="$(arg sim_gazebo)">
      <!-- Gazebo plugins -->
      <gazebo reference="world">
      </gazebo>
      <gazebo>
        <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
          <parameters>${simulation_controllers}</parameters>
          <controller_manager_node_name>${prefix}controller_manager</controller_manager_node_name>
        </plugin>
      </gazebo>
    </xacro:if>

  </xacro:macro>
</robot>
