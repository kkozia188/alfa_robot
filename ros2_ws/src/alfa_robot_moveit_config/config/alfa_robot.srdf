        <joint name="rear_left_wheel_joint"/>
        <joint name="rear_right_steering_joint"/>
        <joint name="rear_right_wheel_joint"/>
        <joint name="updown"/>
        <joint name="head_joint"/>
        <joint name="left_hand_joint"/>
        <joint name="right_hand_joint"/>
        <group name="dual_arm"/>
    </group>
